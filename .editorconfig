root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{html,yml,yaml,json,md}]
indent_size = 2

# Los .sh necesitan LF si o si (el shebang muere con CRLF); .gitattributes lo fuerza en git,
# esto lo fuerza en el editor.
[*.sh]
end_of_line = lf

# En Markdown el espacio doble al final de linea es un line break: no recortarlo.
[*.md]
trim_trailing_whitespace = false
